# StockSpace environment variables — copy to .env and adjust.
# Never commit real secrets. Only placeholders live in this file.

# PostgreSQL connection used by the API and Prisma (Phase 2).
# The compose `db` service publishes host port 5433 (container 5432) to avoid
# clashing with a locally installed PostgreSQL on 5432.
DATABASE_URL=postgresql://stockspace:stockspace@localhost:5433/stockspace

# Separate database used by API integration tests.
DATABASE_URL_TEST=postgresql://stockspace:stockspace@localhost:5433/stockspace_test

# Base URL of the REST API used by the web app (Phase 3).
VITE_API_URL=http://localhost:4000

# Auth secret for sessions (Phase 4). Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
