// StockSpace data model — see docs/database.md for the rationale of every
// constraint. Identifiers are UUIDs (non-guessable per PRD §10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum LocationType {
  RACK
  STAGING
  PACKING
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum NotificationType {
  LOW_STOCK
  INFO
}

// User/Session/Account/Verification fields follow better-auth's core schema
// (https://www.better-auth.com/docs/concepts/database) — mapped to our
// PascalCase model names via the prisma adapter's modelMapping.
model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  authProviderId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  memberships    WorkspaceMember[]
  movements      StockMovement[]   @relation("MovementActor")
  notifications  Notification[]
  accounts       Account[]
  sessions       Session[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("IDR")
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now())
  members    WorkspaceMember[]
  warehouses Warehouse[]
  categories Category[]
  products   Product[]
  movements  StockMovement[]
  notifications Notification[]
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  workspaceId String
  userId      String
  role        MemberRole @default(STAFF)
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Warehouse {
  id          String @id @default(uuid())
  workspaceId String
  name        String
  code        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  zones       Zone[]
  locations   StorageLocation[]

  @@unique([workspaceId, code])
}

model Zone {
  id          String @id @default(uuid())
  warehouseId String
  name        String
  code        String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locations   StorageLocation[]

  @@unique([warehouseId, code])
}

model StorageLocation {
  id               String       @id @default(uuid())
  warehouseId      String
  zoneId           String?
  type             LocationType
  code             String
  label            String
  // Persisted layout coordinates — the 3D scene renders from these.
  x                Float
  z                Float
  rotation         Float        @default(0)
  capacity         Int?
  levels           Int          @default(1)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone             Zone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  balances         InventoryBalance[]
  outgoingMovements StockMovement[] @relation("MovementSource")
  incomingMovements StockMovement[] @relation("MovementDestination")

  @@unique([warehouseId, code])
}

model Category {
  id          String @id @default(uuid())
  workspaceId String
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([workspaceId, name])
}

model Product {
  id              String   @id @default(uuid())
  workspaceId     String
  sku             String
  name            String
  categoryId      String?
  unit            String   @default("pcs")
  barcode         String?
  // Money is Decimal(14,2) — never floating point.
  costPrice       Decimal  @default(0) @db.Decimal(14, 2)
  reorderThreshold Int     @default(0)
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  balances        InventoryBalance[]
  movements       StockMovement[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, active])
  @@index([name])
}

model InventoryBalance {
  id               String   @id @default(uuid())
  productId        String
  locationId       String
  // Shelf level inside a rack (1 = bottom); flat rows (staging/packing) use 1.
  level            Int      @default(1)
  quantity         Int
  updatedAt        DateTime @updatedAt
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  location         StorageLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId, level])
  @@index([locationId])
  @@index([productId])
}

model StockMovement {
  id                   String       @id @default(uuid())
  workspaceId          String
  productId            String
  type                 MovementType
  // Positive for IN/OUT/TRANSFER; signed delta for ADJUSTMENT.
  quantity             Int
  sourceLocationId     String?
  destinationLocationId String?
  sourceLevel          Int?
  destinationLevel     Int?
  reference            String?
  note                 String?
  actorId              String
  createdAt            DateTime     @default(now())
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product              Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation       StorageLocation? @relation("MovementSource", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocation  StorageLocation? @relation("MovementDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  actor                User             @relation("MovementActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@index([productId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
}

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String?
  type        NotificationType @default(INFO)
  title       String
  body        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, readAt])
}
